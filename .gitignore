# Signing material — never commit (the keystore comes from GitHub Actions
# secrets at build time; see signing/README.md)
*.keystore
*.jks
key.properties

# Android / Gradle build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
.gradle/

# The loomnet facade AAR is built by CI (gomobile bind) into app/libs/
android/app/libs/*.aar
android/app/libs/*-sources.jar

# Compiled native binaries are fetched from a pinned Release asset at build time
# (URL + sha256 live in jniLibs.lock) — never commit them. Each release would add
# another ~82MB blob that git cannot delta-compress, which is exactly how this
# repo's .git grew to 734MB. See the "Fetch libvantaloom.so" step in build-apk.yml.
android/app/src/main/jniLibs/

# The compiled web export is staged into app assets by CI (source of truth: web/)
android/app/src/main/assets/*
!android/app/src/main/assets/README.md

# Public web exports are compiled assets only: source maps may embed sourcesContent,
# expose proprietary source, and are rejected by the APK CI gate. Never force-add.
web/**/*.map
web/**/*.ts
web/**/*.tsx
web/**/*.jsx

node_modules/
dist/
.cursor/
.idea/
*.iml
local.properties
