# Signing material — never commit (the keystore comes from GitHub Actions
# secrets at build time; see signing/README.md)
*.keystore
*.jks
key.properties

# Android / Gradle build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
.gradle/

# The loomnet facade AAR is built by CI (gomobile bind) into app/libs/
android/app/libs/*.aar
android/app/libs/*-sources.jar

# Compiled native binaries are fetched from a Release asset at build time —
# never commit them. Each release would add another ~82MB blob that git cannot
# delta-compress, which is exactly how this repo's .git grew to 734MB.
android/app/src/main/jniLibs/

# The compiled Next.js export is the private repo's build product. It ships as
# the `web.tar.zst` asset of the same Release that triggers the CI build, and is
# unpacked during the workflow. ~47MB per release, and Next.js chunk filenames
# carry a content hash, so every export added ~77% brand-new blobs to history.
web/

# The compiled web export is staged into app assets by CI at build time.
android/app/src/main/assets/*
!android/app/src/main/assets/README.md

# Belt and braces: if a web/ copy ever reappears locally (e.g. unpacked by hand
# while debugging CI), never let source maps or TS/JSX sources get committed.
# .map files embed sourcesContent and would leak the proprietary frontend source.
web/**/*.map
web/**/*.ts
web/**/*.tsx
web/**/*.jsx

node_modules/
dist/
.cursor/
.idea/
*.iml
local.properties
